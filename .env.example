# Postgres (Container-Zugangsdaten für docker-compose)
POSTGRES_USER=bothy
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bothy

# Prisma / App: Verbindung zur Datenbank.
# Lokal ohne Docker: localhost statt "postgres" als Host.
DATABASE_URL="postgresql://bothy:changeme@postgres:5432/bothy?schema=public"

# Domain für Caddy (Reverse Proxy + automatisches HTTPS).
# Lokal: localhost. Produktiv: echte Domain oder Tailscale-Hostname
# (siehe PLAN.md Abschnitt 1 und 6 — Tailscale-Zertifikat nötig,
# selbstsigniert reicht auf Android nicht).
DOMAIN=localhost

# Invite-Code fürs Setup (beide Personen registrieren sich damit einmalig).
INVITE_CODE=changeme

# HMAC-Secret für signierte Session-/Challenge-Cookies.
# Erzeugen mit: openssl rand -base64 32
SESSION_SECRET=changeme

# VAPID-Schlüsselpaar für Web Push.
# Erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_SUBJECT=mailto:changeme@example.com
# Gleicher Wert wie VAPID_PUBLIC_KEY, NEXT_PUBLIC_* wird ans Frontend ausgeliefert
NEXT_PUBLIC_VAPID_PUBLIC_KEY=changeme
